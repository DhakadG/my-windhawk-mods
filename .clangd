# Shared configuration for every mod in this repository.
#
# Without these, clangd has no idea Windhawk ships its own MinGW libc++, and falls back to the
# MSVC STL headers it finds through the registry. Its MinGW target cannot parse those, so the
# editor reports two dozen errors inside <xstring> that have nothing to do with any mod here.
#
# The clang version in the include path is pinned because clangd has no globbing. It has to be
# updated by hand after a Windhawk compiler update, and the symptom of forgetting is the same
# wall of <xstring> errors this file exists to prevent.
CompileFlags:
  Add:
    - --target=x86_64-w64-windows-gnu
    - -std=c++23
    - -nostdinc++
    - -isystem
    - C:/Program Files/Windhawk/Compiler/include/c++/v1
    - -isystem
    - C:/Program Files/Windhawk/Compiler/lib/clang/20/include
    - -isystem
    - C:/Program Files/Windhawk/Compiler/include
    - -DUNICODE
    - -D_UNICODE
    - -DWINVER=0x0A00
    - -D_WIN32_WINNT=0x0A00
    - -D_WIN32_IE=0x0A00
    - -DNTDDI_VERSION=0x0A000008
    - -D__USE_MINGW_ANSI_STDIO=0
    - -DWH_MOD
    - -DWIN32_LEAN_AND_MEAN
    - -include
    - C:/Program Files/Windhawk/Compiler/include/windhawk_api.h
    - -Wno-pragma-pack
    - -Wno-pragma-system-header-outside-header

Diagnostics:
  Suppress:
    - unused-includes

---
# `WH_MOD_ID` is one mod's identity, so it belongs to one mod's files.
#
# It started in the block above, where it handed every mod in this repository *this* mod's id
# in editor analysis - wrong for all of them, and silently so, because nothing in an editor
# complains about a module id that merely disagrees with the file it is looking at.
#
# One of these per mod that needs it.
If:
  PathMatch: mods/taskbar-ai-quota-fork/.*
CompileFlags:
  Add:
    - -DWH_MOD_ID=L"taskbar-ai-quota-fork"
